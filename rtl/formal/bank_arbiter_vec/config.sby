# The same arbiter proof on the VEC pad (SP_ID = 3): the row-banked 2-D range adds the serial path of phase 8 K2
# (a row-slice request into the range is served element by element on port A and granted with its last element).
# WORDS is kept small (the banks are abstracted); the range test uses the address alone.
[options]
mode bmc
depth 24

[engines]
smtbmc yices

[script]
plugin -i slang
read_slang -D FORMAL -G WORDS=16 -G SP_ID=4'd3 -G READERS=127 -G WRITERS=127 --top scratchpad tcta_isa_pkg.sv tcta_pkg.sv scratchpad.sv
prep -top scratchpad
memory_map

[files]
../src/tcta_isa_pkg.sv
../src/tcta_pkg.sv
../src/scratchpad.sv
